//*********************************************************************************
//** Function Name: displayMessage
//**
//** Description: This function enable the div tag which displays the message
//**	          eg., "Saving the record ..." , "Deleting the record ..." etc
//**
//**
//** Parameters:
//**	id: Is name of the element displaying message
//**	Type: String
//**	Purpose: To enable the DIV tag with the message 
//**
//**    msg: Is the message to be displayed for id tag
//**    Type:  String
//**    Purpose: To display the message with the DIV tag 
//*********************************************************************************

var cstrMessageSave = "Saving the record ...";
var cstrMessageCancel = "Navigating to viewer page ...";
var cstrMessageDelete = "Deleting the record ...";
var cstrMessageUnDelete = "UnDeleting the record ...";
var cstrMessageAdd = "Adding the record ...";
var cstrMessageUpdate = "Updating the record ...";

var cstrMessageTabEdit = "Navigating to Edit page ...";
var cstrMessageEdit = "Navigating to Full Screen Edit page ...";
var cstrMessageCopy = "Copying the record ...";

function displayMessage(id, msg)
{
	document.getElementById(id).style.display = "block";
	document.getElementById(id).innerHTML = msg;
}




//*********************************************************************************
//** Function Name:  disableButton
//**
//** Description: This function disables the button
//**
//**
//** Parameters:
//**	id: Is name of the button to be disabled
//**	Type: String
//**	Purpose: To disable the button. 
//**
//*********************************************************************************

function disableButton(id)
{
	if ( document.getElementById(id) != null )
		document.getElementById(id).disabled = true;
}




//*********************************************************************************
//** Function Name: trim
//**
//** Description: This function gets rid of the leading and trailing spaces on 
//**	a string
//**
//**
//** Parameters:
//**	Name: rstrString
//**	Type: String
//**	Purpose: The from which the spaces are to be removed
//**
//** Return Values:
//**	True: Continue with the submission
//**	False: Cancel the submission
//*********************************************************************************
function trim( rstrString )
{
	var lstrString = new String( rstrString );
	var lintLoop;
	var lintStart;
	var lintEnd;

	for ( lintLoop = 0; lintLoop < lstrString.length; lintLoop++ )
		if ( lstrString.charAt( lintLoop ) != ' ' )
			break;

	if ( lintStart == lstrString.length )
		return "";

	lintStart = lintLoop;

	for ( lintLoop = lstrString.length - 1; lintLoop > -1; lintLoop-- )
		if ( lstrString.charAt( lintLoop ) != ' ' )
			break;

	lintEnd = lintLoop + 1;

	lstrString = lstrString.substring( lintStart, lintEnd );

	return lstrString;
}



//*********************************************************************************
//** Function Name: checkRequired
//**
//** Description: Verifies that the required data for a form has been entered.
//**	Required fields are defined as fields with the prefix 'reqd'
//**	An empty field is a field with only spaces or no data.
//**
//** Paremeters:
//**	Name: theForm
//**	Type: a form object
//**	Purpose: the form that is to be checked
//**
//** Return Values:
//**	True: Good data
//**	False: Bad Data
//*********************************************************************************
function checkRequired(theForm)
{
	var pass = true;
	
	for ( i=0; i < theForm.length; i++ )
	{
		var obj = theForm.elements[i];
		if (( obj.name.substring( 0,4 )).toLowerCase()=="reqd" )
		{
			if (((obj.type=="text"||obj.type=="textarea")&&obj.value=='')||(obj.type.toString().charAt(0)=="s"&&obj.selectedIndex==-1)){
				pass = false;
				break;
			}
		 }
	}
	if ( !pass )
	{
		alert("One or more of the required elements are not completed. Please complete them, then submit again!")
		return false
	}
	else
		return true
}



//*********************************************************************************
//** Function Name: checkRequiredField
//**
//** Description: Checks if a field has atleast one character (not space)
//**	Displays simple error messages on errors and moves cursor to
//**		problem fields.
//**
//** Paremeters:
//**	Name: robjForm
//**	Type: a form object
//**	Purpose: the form that is to be checked
//**
//**	Name: rstrFieldName
//**	Type: string
//**	Purpose: the name of the field within the form to be checked
//**
//**	Name: rstrFieldLabel
//**	Type: a string
//**	Purpose: the label of the field within the form to be checked( used in 
//**		error messages )
//**
//** Return Values:
//**	True: Good data
//**	False: Bad Data
//*********************************************************************************
function checkRequiredField( robjForm, rstrFieldName, rstrFieldLabel )
{
	var lobjInput = robjForm.elements[rstrFieldName];
	var lstrValue = lobjInput.value
	var lintLength = lstrValue.length
	
	// Check the field length.
	if( lintLength < 1 )
	{
		alert("Please input a value in the required field (" + rstrFieldLabel + ")!");
		lobjInput.focus();
		lobjInput.select();
		return false
	}
	else 
	{
		// Checking for blanks
		var lintLoop = 0
		var lbooAllBlank = true
		
		// loop through all characters in string
		while ( lintLoop < lintLength && lbooAllBlank )
		{
			if (( lstrValue.charAt( lintLoop ) != " " ))
				lbooAllBlank = false
			lintLoop++
		}
		
		// Error message for all blanks
		if ( lbooAllBlank )
		{
		  alert("Please input a value in the required field (" + rstrFieldLabel + ")!");
		  lobjInput.focus();
		  lobjInput.select();
		  return false
		}
	}
	return true
}



//*********************************************************************************
//** Function Name: checkMaxlength
//**
//** Description: checks max length of a field
//**
//** Paremeters:
//**	Name: robjForm
//**	Type: a form object
//**	Purpose: the form that is to be checked
//**
//**	Name: rstrFieldName
//**	Type: string
//**	Purpose: the name of the field within the form to be checked
//**
//**	Name: rintMaxLength
//**	Type: a string
//**	Purpose: the maximum length of the string
//**
//** Return Values:
//**	True: Good data
//**	False: Bad Data
//*********************************************************************************
function checkMaxlength( robjForm, rstrFieldName, rintMaxLength )
{
	var lobjElement = robjForm.elements[ rstrFieldName ];
	var x = lobjElement.value;
	if ( x.length > rintMaxLength )
	{
		alert( "Please restrain your input to less than " + rintMaxLength + " characters!" );
		lobjElement.focus();
		lobjElement.select();
		return false;
	}
	return true;
}



//*********************************************************************************
//** Function Name: checkMinLength
//**
//** Description: checks Minimum length of a field
//**
//** Paremeters:
//**	Name: robjForm
//**	Type: a form object
//**	Purpose: the form that is to be checked
//**
//**	Name: rstrFieldName
//**	Type: string
//**	Purpose: the name of the field within the form to be checked
//**
//**	Name: rstrLabel
//**	Type: string
//**	Purpose: The label to use in the error message
//**
//**	Name: rintMinLength
//**	Type: integer
//**	Purpose: the minimum length
//**
//** Return Values:
//**	True: Good data
//**	False: Bad Data
//*********************************************************************************
function checkMinLength( robjForm, rstrFieldName, rstrLabel, rintMinLength)
{
	var lobjElement = robjForm.elements[ rstrFieldName ];
	var x = lobjElement.value;
	
	if ( x.length < rintMinLength )
	{
		alert("Please input at least " + rintMinLength + " characters (" + rstrLabel + ")!");
		lobjElement.focus();
		lobjElement.select();
		return false
	}
	return true
}



//*********************************************************************************
//** Function Name: checkMaxLength
//**
//** Description: checks Minimum length of a field
//**
//** Paremeters:
//**	Name: robjForm
//**	Type: a form object
//**	Purpose: the form that is to be checked
//**
//**	Name: rstrFieldName
